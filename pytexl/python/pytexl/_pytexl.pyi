"""Type stubs of the native module of pytexl. Use the classes of :mod:`pytexl`."""

from collections.abc import Generator, Mapping
from typing import Any

from . import Loader

class Promise:
    """A Swan promise. Await it to get its value, converted to a Python value.

    Promises never fail: an operation that cannot produce a value resolves to
    ``None``. Await a promise inside a running asyncio event loop.
    """

    @property
    def done(self) -> bool:
        """bool: True once the promise has a value."""

    def __await__(self) -> Generator[Any, None, Any]: ...

class Function:
    """A Swan function. Call it like a Python function.

    No argument is passed as ``Nothing``, one argument as itself, and several
    arguments as a tuple. Calling a Swan function never raises: an invalid call
    returns an :class:`Undefined`.
    """

    def __call__(self, *args: Any) -> Any: ...

class Undefined:
    """A Swan undefined value: the result of an invalid operation, such as ``"a" - 1``.

    Its attributes are the members of ``undef.inspect`` in Swan; those that do
    not apply to its ``type`` are ``None``. An ``Undefined`` is falsy, and
    passing it back to Swan gives the original undefined value.
    """

    @property
    def type(self) -> str: ...
    @property
    def op(self) -> str | None: ...
    @property
    def val(self) -> Any: ...
    @property
    def lhv(self) -> Any: ...
    @property
    def rhv(self) -> Any: ...
    @property
    def pos(self) -> int | None: ...
    @property
    def expected(self) -> str | None: ...
    @property
    def token(self) -> str | None: ...
    def inspect(self) -> dict[str, Any]: ...
    def __bool__(self) -> bool: ...

class NativeEngine:
    def __init__(self, base_url: str) -> None: ...
    @property
    def base_url(self) -> str: ...
    def set(self, name: str, value: Any) -> None: ...
    def add_loader(self, scheme: str, loader: Loader) -> None: ...
    def set_default_loader(self, loader: Loader) -> None: ...
    def resolve(self, uri: str) -> str: ...
    def load(self, uri: str) -> Promise: ...
    def render(self, template: str) -> Promise: ...
    def create_context(self, vars: Mapping[str, Any] | None = None, uri: str | None = None) -> NativeContext: ...

class NativeContext:
    def get(self, name: str) -> Any: ...
    def set(self, name: str, value: Any) -> None: ...
    def names(self) -> list[str]: ...
    def render(self, template: str) -> Promise: ...
